# Base path/URL to your 5etools root — the directory that contains
# both data/ (races.json) and homebrew/ (index.json, content-blocklist.json, *.json).
#
# fetch-data reads from these sources to build data/archetypes.js.
# features.js and locations.js are local config files you edit by hand.
#
# Sources are tried in order; the first one that succeeds wins.

# 1. Local filesystem (absolute path to the 5etools root)
LOCAL_DATA_PATH=/Volumes/web/5e

# 2. Local network (LAN URL to the 5etools root)
NETWORK_DATA_URL=http://10.0.0.102/5e

# 3. Remote URL
REMOTE_DATA_URL=http://thedice.monster/5e
